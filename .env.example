# Copy this file to .env and fill in your values.

# REQUIRED: create a bot with @BotFather on Telegram, paste the token here.
TELEGRAM_BOT_TOKEN=

# OPTIONAL: enables the LLM co-pilot (daily brief, /check, weekly review).
# Without it, everything else still works.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5
# TIMEZONE=Asia/Colombo
# BRIEF_HOUR=8
